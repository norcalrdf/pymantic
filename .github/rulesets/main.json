      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "Pymantic Tests (3.10)", "integration_id": 15368 },
          { "context": "Pymantic Tests (3.11)", "integration_id": 15368 },
          { "context": "Pymantic Tests (3.12)", "integration_id": 15368 },
          { "context": "Pymantic Tests (3.13)", "integration_id": 15368 },
          { "context": "Pymantic Tests (3.14)", "integration_id": 15368 },
          { "context": "Lint", "integration_id": 15368 }
        ]
      }
    }
  ]
